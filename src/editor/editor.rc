#include <windows.h>

// =====================================================================
// AutoMapper version: the only place it is written.
//   - Windows Explorer file properties read the VERSIONINFO block below.
//   - Qt reads ProductVersion for QCoreApplication::applicationVersion().
//   - pack_release.bat reads AUTO_MAPPER_VERSION_TEXT to name the package.
// Keep the two lines in step when bumping the version.
// =====================================================================
#define AUTO_MAPPER_VERSION_TEXT "1.1.0"
#define AUTO_MAPPER_VERSION_NUMBER 1,1,0,0

IDI_ICON1 ICON "../../assets/logo.ico"

// File properties shown by Windows Explorer.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     AUTO_MAPPER_VERSION_NUMBER
PRODUCTVERSION  AUTO_MAPPER_VERSION_NUMBER
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Feiyang"
            VALUE "FileDescription",  "AutoMapper"
            VALUE "FileVersion",      AUTO_MAPPER_VERSION_TEXT
            VALUE "InternalName",     "AutoMapper.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Feiyang"
            VALUE "OriginalFilename", "AutoMapper.exe"
            VALUE "ProductName",      "AutoMapper"
            VALUE "ProductVersion",   AUTO_MAPPER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
