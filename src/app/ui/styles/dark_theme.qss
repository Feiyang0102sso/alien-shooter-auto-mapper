QMainWindow {
    background: #10161a;
    color: #d9e8e2;
}

QToolBar {
    background: #172126;
    border: 0;
    border-bottom: 1px solid #263740;
    spacing: 8px;
    padding: 8px;
}

#languageToggleButton,
#hotkeyHelpButton {
    background: #223039;
    border: 1px solid #36505d;
    border-radius: 6px;
    padding: 0px;
}

#languageToggleButton:hover,
#hotkeyHelpButton:hover {
    background: #2a3d47;
    border-color: #4f7fbf;
}

#drawingToolbar {
    border-right: 1px solid #263740;
    border-bottom: 0;
    spacing: 6px;
    padding: 8px 6px;
}

QToolButton {
    background: #223039;
    border: 1px solid #36505d;
    border-radius: 6px;
    color: #d9e8e2;
    padding: 7px 10px;
}

QToolButton:hover {
    background: #2a3d47;
    border-color: #4f7fbf;
}

QToolButton:checked {
    background: #2aa879;
    border-color: #45c797;
    color: #07110d;
}

QCheckBox {
    color: #d9e8e2;
    spacing: 7px;
    padding: 5px 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4a6573;
    border-radius: 3px;
    background: #10161a;
}

QCheckBox::indicator:checked {
    background: #2aa879;
    border-color: #45c797;
}

QCheckBox[unavailable="true"] {
    color: #6f8580;
}

QCheckBox[unavailable="true"]::indicator {
    border-color: #46525a;
    background: #20282d;
}

QDockWidget {
    color: #d9e8e2;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: #172126;
    border: 1px solid #263740;
    padding: 8px;
}

#leftShelfPanel,
#decorationShelfPanel,
#inspectorPanel {
    background: #121b20;
    border-left: 1px solid #263740;
    border-right: 1px solid #263740;
}

#leftShelfTabs {
    background: #121b20;
    border-left: 1px solid #263740;
    border-right: 1px solid #263740;
}

#leftShelfTabs::pane {
    border: 0;
    top: -1px;
}

#leftShelfTabs QTabBar::tab {
    background: #172126;
    border: 1px solid #263740;
    color: #9fb4ad;
    padding: 8px 14px;
    min-width: 92px;
}

#leftShelfTabs QTabBar::tab:selected {
    background: #223039;
    border-bottom-color: #223039;
    color: #f1f6f3;
}

#leftShelfTabs QTabBar::tab:hover {
    color: #f1f6f3;
}

#panelTitle {
    color: #f1f6f3;
    font-size: 18px;
    font-weight: 700;
}

#themeCard {
    background: #182329;
    border: 1px solid #2d414c;
    border-radius: 8px;
}

#themeCard:hover {
    border-color: #2aa879;
}

#mainToolbar QToolButton,
#mainToolbar QCheckBox {
    min-height: 40px;
}

#themeCard[selected="true"] {
    border: 2px solid #45c797;
    background: #1d2c31;
}

#themeShelfScrollArea {
    background: transparent;
    border: 0;
}

#themeShelfScrollContent {
    background: transparent;
}

#inspectorScrollArea,
#inspectorScrollViewport {
    background: #121b20;
    border: 0;
}

#themePreview {
    background: #0d1317;
    border-radius: 6px;
    min-height: 118px;
    max-height: 118px;
}

#decorationPreview {
    background: #0f1f1a;
    border: 1px dashed #2aa879;
    border-radius: 6px;
    color: #69f0ae;
    min-height: 118px;
    max-height: 118px;
}

#cardTitle {
    color: #f1f6f3;
    font-size: 15px;
    font-weight: 700;
}

#cardDetail {
    color: #9fb4ad;
    font-size: 12px;
}

#wallSetLegendLabel {
    color: #b8cbc4;
    font-size: 10px;
}

QPushButton {
    background: #24353e;
    border: 1px solid #3c5b68;
    border-radius: 6px;
    color: #d9e8e2;
    padding: 7px 10px;
}

QPushButton:hover {
    background: #2aa879;
    border-color: #45c797;
    color: #07110d;
}

#gameFamilyButton {
    min-height: 36px;
    font-size: 14px;
    font-weight: 700;
}

#gameFamilyButton:checked {
    background: #2aa879;
    border-color: #45c797;
    color: #07110d;
}

#shelfModeButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid #2f4550;
    border-radius: 0;
    color: #9fb4ad;
    font-size: 12px;
    font-weight: 600;
    min-height: 26px;
    padding: 4px 6px;
}

#shelfModeButton:hover {
    background: transparent;
    border-bottom-color: #45c797;
    color: #d9e8e2;
}

#shelfModeButton:checked {
    background: transparent;
    border-bottom-color: #45c797;
    color: #69f0ae;
}

#shelfModeButton:disabled {
    border-bottom-color: #263238;
    color: #55666a;
}

QComboBox {
    background: #182329;
    border: 1px solid #36505d;
    border-radius: 6px;
    color: #d9e8e2;
    padding: 7px 10px;
}

QComboBox QAbstractItemView {
    background: #121b20;
    border: 1px solid #36505d;
    color: #e8f4ef;
    selection-background-color: #2a3d47;
    selection-color: #ffffff;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 6px 10px;
}

QComboBox QAbstractItemView::item:hover {
    background: #1f302c;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:selected {
    background: #2aa879;
    color: #07110d;
}

QDoubleSpinBox,
QSpinBox {
    background: #182329;
    border: 1px solid #36505d;
    border-radius: 6px;
    color: #d9e8e2;
    padding: 6px 8px;
}

QSlider::groove:horizontal {
    background: #2d414c;
    border: 1px solid #3c5b68;
    border-radius: 3px;
    height: 6px;
}

QSlider::sub-page:horizontal {
    background: #2aa879;
    border: 1px solid #45c797;
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #223039;
    border: 1px solid #2d414c;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #f1f6f3;
    border: 2px solid #2aa879;
    border-radius: 7px;
    height: 14px;
    margin: -5px 0;
    width: 14px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #45c797;
}

#as1CeilingPropertiesGroup:disabled,
#as1CeilingPropertiesGroup QLabel:disabled {
    color: #6f8580;
}

#as1CeilingPropertiesGroup QSpinBox:disabled {
    background: #20282d;
    border-color: #35434a;
    color: #6f8580;
}

#as1CeilingPropertiesGroup QSlider::groove:horizontal:disabled,
#as1CeilingPropertiesGroup QSlider::add-page:horizontal:disabled,
#as1CeilingPropertiesGroup QSlider::sub-page:horizontal:disabled {
    background: #263238;
    border-color: #35434a;
}

#as1CeilingPropertiesGroup QSlider::handle:horizontal:disabled {
    background: #65736f;
    border-color: #465752;
}

QGroupBox {
    border: 1px solid #2d414c;
    border-radius: 8px;
    color: #d9e8e2;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #f1f6f3;
}

#toolPropertiesGroup,
#toolPropertiesGroup::title,
#toolPropertiesGroup QLabel,
#decorationPropertiesGroup,
#decorationPropertiesGroup::title,
#decorationPropertiesGroup QLabel {
    color: #f1f6f3;
}

#activeThemeLabel {
    background: #1f302c;
    border: 1px solid #2aa879;
    border-radius: 6px;
    color: #dff8ed;
    padding: 10px;
}

#componentPreview {
    background: #0d1317;
    border: 1px dashed #3c5b68;
    border-radius: 8px;
    color: #6f8580;
    qproperty-alignment: AlignCenter;
}

QStatusBar {
    background: #172126;
    color: #9fb4ad;
}

QScrollBar:vertical {
    background: #10161a;
    border: 0;
    margin: 0;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #36505d;
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #4f7fbf;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: 0;
}

#inspectorPanel QLabel {
    color: #d9e8e2;
}
