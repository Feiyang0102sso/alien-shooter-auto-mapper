# --- IDE configuration file ---
.idea/
.vscode/

# --- Python cached files (standard ignore) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- pyproject / env ---
*.egg-info/
.venv/
venv/
ENV/
.env

# --- LOGS ---
*.log
*.tmp
ui_settings.json

# --- C / C++ / Visual Studio ---
# vs/AutoMapper.sln: bin/ holds the exes and their runtime files, out/ the intermediate files.
/bin/
/out/
.vs/
*.vcxproj.user
*.obj
*.exe
*.dll
*.lib
*.pdb
*.ilk

# --- Project Specific (Auto Mapper) ---
*.map
!empty.map
!*_sample.map
# Decoration library maps are runtime assets: their regions become Decoration Stamps.
!assets/decoration_maps/**/*.map
release/
dist/

# --- testing / output ---
tests/out/
tests/output/
test_output.map
!tests/golden/**/*.map

# --- some personal note ---
_personal_note/
_prep_for_img/
#*.bat
#*.png
AutoMapper.cfg
auto_mapper_project.json
color_palette_preview.html
ceiling-curtain-adjustment.html
*.bak

# --- AS2 local lookup data / generated report ---
_prepare/AS2/ini/
_prepare/AS2/_vid_army_report.txt
_prepare/AS2/decoration/*.svg

# --- local research demo (terrain curve interaction) ---
terrain_curve_demo.html
